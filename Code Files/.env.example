# Gemini API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Current model defaults. Change these if your API project uses different models.
GEMINI_WORKOUT_MODEL=gemini-3.1-pro-preview
GEMINI_TIP_MODEL=gemini-3.8-flash

# SQLite database path
DATABASE_URL=sqlite:///./data/fitbuddy.db

# Set true to run without a Gemini key. Useful for UI development/tests.
DEMO_MODE=false

# Local admin credentials for /view-all-users
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional application settings
APP_NAME=FitBuddy
DEBUG=false
